# Gemini AI server-side API key.
GEMINI_API_KEY=""
GEMINI_TEXT_MODELS="gemini-3.5-flash-lite"
GEMINI_IMAGE_MODEL="imagen-4.0-generate-001"
GEMINI_TIMEOUT_MS="45000"
AI_DAILY_REQUEST_LIMIT="100"
AI_AVATAR_ENABLED="false"
RELEASE_VERSION="local"

# Firebase Admin credentials used only by the server. Keep the escaped \n
# characters in the private key when setting this value in Vercel.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# App URL used by hosted deployments.
APP_URL="http://localhost:3000"

# Firebase client config exposed to Vite.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Public build label; no credentials.
VITE_RELEASE_VERSION="local"
