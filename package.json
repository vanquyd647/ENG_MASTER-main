{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/build-offline-pack.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs",
    "start": "node build/server.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src api server.ts && npm run validate:vocab",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api-runtime": "node --no-experimental-require-module scripts/check-api-runtime.mjs",
    "test:emulator": "node scripts/check-firestore-emulator.mjs && vitest run --no-file-parallelism src/lib/firestoreEmulator.test.ts src/server/apiSecurity.emulator.test.ts",
    "normalize:vocab": "node --import tsx scripts/normalize-vocabulary.ts",
    "import:vocab:pdf": "node --import tsx scripts/import-toeic-pdf.ts",
    "review:vocab": "node --import tsx scripts/apply-vocabulary-review.ts",
    "validate:vocab": "node --import tsx scripts/validate-vocabulary.ts",
    "qa:ai-quality": "node --import tsx scripts/check-ai-quality.mjs",
    "audit:learning": "node --import tsx scripts/audit-learning-readiness.mjs"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4",
    "uuid": "^11.1.1",
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "6.4.299",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cspell/dict-en-common-misspellings": "^2.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "ipa-dict": "^1.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.8"
  }
}
